{
  "name": "eduna-ts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "check-tree": "npm ls react react-dom next --all",  
    "check-runtime": "node -e \"const v8=require('v8'); console.log('Node:',process.version); console.log('Platform:',process.platform); console.log('Arch:',process.arch); console.log('NODE_ENV:',process.env.NODE_ENV); console.log('NODE_OPTIONS:',process.env.NODE_OPTIONS); console.log('Heap:',Math.round(v8.getHeapStatistics().heap_size_limit/1024/1024)+' MB'); console.log('execPath:',process.execPath);\"",  
    "check-versions": "node -e \"console.log('cwd:',process.cwd()); console.log('next:',require('next/package.json').version); console.log('react:',require('react/package.json').version); console.log('react-dom:',require('react-dom/package.json').version); console.log('next path:',require.resolve('next')); console.log('react path:',require.resolve('react')); console.log('react-dom path:',require.resolve('react-dom'));\""
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "gsap": "^3.13.0",
    "next": "15.5.0",
    "react": "19.1.0",
    "react-bootstrap": "^2.10.10",
    "react-countup": "^6.5.3",
    "react-dom": "19.1.0",
    "react-nice-select": "^1.0.6",
    "react-player": "^3.3.1",
    "react-visibility-sensor": "^5.1.1",
    "split-type": "^0.3.4",
    "swiper": "^11.2.10",
    "wowjs": "^1.1.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
